{
	"name": "ironkit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint --max-warnings=0 --cache .",
		"lc": "pnpm lint && pnpm check",
		"test:unit": "vitest",
		"test": "pnpm test:unit -- --run",
		"assets:generate": "pwa-assets-generator --preset minimal-2023 pwa-assets/symbol.svg"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.9",
		"@eslint/js": "^9.28.0",
		"@internationalized/date": "^3.8.2",
		"@lucide/svelte": "^0.513.0",
		"@sveltejs/adapter-vercel": "^5.7.2",
		"@sveltejs/kit": "^2.21.4",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tailwindcss/vite": "^4.1.8",
		"@tanstack/table-core": "^8.21.3",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.8",
		"@triplit/cli": "^1.0.53",
		"@types/google.accounts": "^0.0.16",
		"@vite-pwa/assets-generator": "^1.0.0",
		"bits-ui": "^2.5.0",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^9.28.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.9.2",
		"formsnap": "^2.0.1",
		"globals": "^16.2.0",
		"jsdom": "^26.1.0",
		"layerchart": "2.0.0-next.6",
		"mode-watcher": "^1.0.8",
		"paneforge": "1.0.0-next.5",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.12",
		"svelte": "^5.33.19",
		"svelte-check": "^4.2.1",
		"svelte-sonner": "^1.0.4",
		"sveltekit-superforms": "^2.26.1",
		"tailwind-merge": "^3.3.0",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.1.8",
		"tw-animate-css": "^1.3.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.34.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^6.3.5",
		"vite-plugin-kit-routes": "^1.0.2",
		"vitest": "^3.2.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.50.0",
		"@svelte-put/copy": "^4.0.0",
		"@triplit/client": "^1.0.42",
		"@triplit/svelte": "^1.0.42",
		"add": "^2.0.6",
		"pnpm": "^10.11.0",
		"powerlifting-formulas": "^0.2.3",
		"runed": "^0.28.0",
		"svelte-dnd-action": "^0.9.61"
	},
	"packageManager": "pnpm@10.12.1"
}
