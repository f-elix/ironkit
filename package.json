{
	"name": "ironkit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint --max-warnings=0 --cache .",
		"lc": "pnpm lint && pnpm check",
		"test:unit": "vitest",
		"test": "pnpm test:unit -- --run",
		"assets:generate": "pwa-assets-generator --preset minimal-2023 pwa-assets/symbol.svg"
	},
	"devDependencies": {
		"@eslint/compat": "1.4.0",
		"@eslint/js": "9.36.0",
		"@internationalized/date": "3.9.0",
		"@lucide/svelte": "0.544.0",
		"@sveltejs/adapter-vercel": "5.10.2",
		"@sveltejs/kit": "2.43.5",
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@tailwindcss/vite": "4.1.13",
		"@tanstack/table-core": "8.21.3",
		"@testing-library/jest-dom": "6.8.0",
		"@testing-library/svelte": "5.2.8",
		"@triplit/cli": "1.0.61",
		"@types/google.accounts": "0.0.18",
		"@vite-pwa/assets-generator": "1.0.1",
		"bits-ui": "2.11.4",
		"clsx": "2.1.1",
		"embla-carousel-svelte": "8.6.0",
		"eslint": "9.36.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.12.4",
		"formsnap": "2.0.1",
		"globals": "16.4.0",
		"jsdom": "27.0.0",
		"layerchart": "2.0.0-next.6",
		"mode-watcher": "1.1.0",
		"paneforge": "1.0.2",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "3.4.0",
		"prettier-plugin-tailwindcss": "0.6.14",
		"svelte": "5.39.6",
		"svelte-check": "4.3.2",
		"svelte-sonner": "1.0.5",
		"sveltekit-superforms": "2.27.1",
		"tailwind-merge": "3.3.1",
		"tailwind-variants": "3.1.1",
		"tailwindcss": "4.1.13",
		"tw-animate-css": "1.4.0",
		"typescript": "5.9.2",
		"typescript-eslint": "8.44.1",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "7.1.7",
		"vitest": "3.2.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@supabase/supabase-js": "2.58.0",
		"@svelte-put/copy": "4.0.0",
		"@triplit/client": "1.0.50",
		"@triplit/svelte": "1.0.50",
		"add": "2.0.6",
		"pnpm": "10.11.0",
		"powerlifting-formulas": "0.2.3",
		"runed": "0.34.0",
		"svelte-dnd-action": "0.9.65"
	},
	"packageManager": "pnpm@10.17.1"
}
