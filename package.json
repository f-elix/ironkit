{
	"name": "ironkit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --open",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --incremental --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --incremental --tsgo --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint --max-warnings=0 --cache .",
		"lc": "pnpm lint && pnpm check",
		"test:unit": "vitest",
		"test": "pnpm test:unit -- --run",
		"assets:generate": "pwa-assets-generator --preset minimal-2023 pwa-assets/symbol.svg",
		"knip": "knip"
	},
	"devDependencies": {
		"@eslint/compat": "1.4.0",
		"@eslint/js": "9.36.0",
		"@internationalized/date": "3.9.0",
		"@lucide/svelte": "0.544.0",
		"@sveltejs/adapter-vercel": "6.3.3",
		"@sveltejs/kit": "2.53.3",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@tailwindcss/vite": "4.1.13",
		"@testing-library/jest-dom": "6.8.0",
		"@testing-library/svelte": "5.2.8",
		"@types/node": "25.1.0",
		"@vite-pwa/assets-generator": "1.0.1",
		"bits-ui": "2.11.4",
		"clsx": "2.1.1",
		"eslint": "9.36.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.12.4",
		"globals": "16.4.0",
		"jsdom": "27.0.0",
		"knip": "5.84.1",
		"mode-watcher": "1.1.0",
		"npm-run-all": "4.1.5",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "3.4.0",
		"prettier-plugin-tailwindcss": "0.6.14",
		"svelte": "5.53.6",
		"svelte-check": "4.4.4",
		"svelte-sonner": "1.0.5",
		"tailwind-merge": "3.3.1",
		"tailwind-scrollbar": "4.0.2",
		"tailwind-variants": "3.1.1",
		"tailwindcss": "4.1.13",
		"tsx": "4.20.6",
		"tw-animate-css": "1.4.0",
		"typescript": "5.9.2",
		"typescript-eslint": "8.44.1",
		"vite": "7.1.7",
		"vitest": "3.2.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@convex-dev/auth": "0.0.90",
		"@convex-dev/better-auth": "0.10.10",
		"@dnd-kit/abstract": "^0.3.2",
		"@dnd-kit/helpers": "0.3.2",
		"@dnd-kit/svelte": "0.3.2",
		"@mmailaender/convex-better-auth-svelte": "0.5.0",
		"@svelte-put/copy": "4.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260227.1",
		"better-auth": "1.4.9",
		"convex": "1.31.7",
		"convex-svelte": "0.0.12",
		"jazz-tools": "0.20.10",
		"powerlifting-formulas": "0.2.3",
		"runed": "0.31.1",
		"svelte-gestures": "5.2.2"
	},
	"packageManager": "pnpm@10.30.1"
}
